{
  "name": "getstead",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.18.0 || >=24.0.0"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev --hostname 127.0.0.1",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --test",
    "test:postgres": "node --env-file-if-exists=.tmp/stead-auth-test.env --test --test-concurrency=1 server/auth/postgres.integration.ts server/cash-flow/postgres.integration.ts server/investments/postgres.integration.ts server/property/postgres.integration.ts server/property/bills.integration.ts server/admin/postgres.integration.ts server/waitlist/postgres.integration.ts server/backup/postgres.integration.ts",
    "db:migrate": "prisma migrate deploy",
    "auth:owner": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --env-file-if-exists=credentials/stead-postgres.env server/auth/owner-cli.ts",
    "build": "next build"
  },
  "dependencies": {
    "@number-flow/react": "^0.6.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "clsx": "^2.1.1",
    "d3-array": "^3.2.5",
    "d3-scale": "^4.0.3",
    "d3-shape": "^3.2.1",
    "motion": "^14.14.0",
    "next": "^16.4.6",
    "otplib": "^13.6.0",
    "pg": "^8.22.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "0.35.5",
    "tailwind-merge": "^3.7.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "prisma": "^7.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "5.9"
  }
}
