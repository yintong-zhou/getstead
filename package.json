{
  "name": "getstead",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.18.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --test",
    "test:oracle": "node --env-file-if-exists=.tmp/stead-auth-test.env --test server/auth/oracle.integration.ts",
    "auth:owner": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --env-file-if-exists=credentials/stead-auth-owner.env server/auth/owner-cli.ts",
    "build": "next build"
  },
  "dependencies": {
    "next": "^16.4.6",
    "oracledb": "^26.0.0",
    "otplib": "^13.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/oracledb": "^26.0.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "tailwindcss": "^4.3.5",
    "typescript": "5.9"
  }
}
