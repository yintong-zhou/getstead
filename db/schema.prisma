generator client {
  provider            = "prisma-client"
  output              = "./generated"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String           @id @default(uuid()) @map("user_id") @db.Uuid
  email        String           @unique @db.VarChar(254)
  displayName  String?          @map("display_name") @db.VarChar(60)
  passwordHash String           @map("password_hash") @db.VarChar(180)
  totpSecret   Bytes?           @map("totp_secret")
  lastTotpStep Int?             @map("last_totp_step")
  // dbgenerated keeps Prisma from sending `role` on INSERT: the runtime role may not write it.
  // ponytail: `prisma migrate diff` reports a no-op SET DEFAULT for this column (Prisma quirk); ignore it.
  role         UserRole         @default(dbgenerated("'USER'::stead_user_role"))
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  lastLoginAt  DateTime?        @map("last_login_at") @db.Timestamptz(3)
  disabledAt   DateTime?        @map("disabled_at") @db.Timestamptz(3)
  mustChangePassword Boolean    @default(false) @map("must_change_password")
  excludeCash  Boolean          @default(false) @map("exclude_cash")
  events       EventLog[]       @relation("EventSubject")
  actions      EventLog[]       @relation("EventActor")
  challenges   LoginChallenge[]
  sessions     Session[]
  accounts     Account[]
  categories   Category[]
  transfers    Transfer[]
  movements    Movement[]
  rules        CategoryRule[]
  limits       BudgetLimit[]
  templates    RecurringTemplate[]
  occurrences  RecurringOccurrence[]
  balanceChecks BalanceCheck[]
  instruments Instrument[]
  investmentTransactions InvestmentTransaction[]
  priceQuotes PriceQuote[]
  properties Property[]
  propertyValuations PropertyValuation[]
  condoTables CondoTable[]
  condoSchedules CondoSchedule[]
  condoCharges CondoCharge[]
  utilityBills UtilityBill[]
  customAccountTypes CustomAccountType[]

  @@map("stead_users")
}

enum UserRole {
  USER
  ADMIN

  @@map("stead_user_role")
}

enum EventKind {
  ERROR
  SECURITY

  @@map("stead_event_kind")
}

/// Server errors and security events for the admin area. Codes and routes only: never emails,
/// payloads, messages, stacks, IPs or amounts. Rows older than 30 days are pruned.
model EventLog {
  id        String    @id @default(uuid()) @map("event_id") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  kind      EventKind
  code      String    @db.VarChar(64)
  route     String?   @db.VarChar(200)
  method    String?   @db.VarChar(8)
  userId    String?   @map("user_id") @db.Uuid
  actorId   String?   @map("actor_id") @db.Uuid
  user      User?     @relation("EventSubject", fields: [userId], references: [id], onDelete: SetNull)
  actor     User?     @relation("EventActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([kind, createdAt])
  @@map("stead_event_logs")
}

model LoginChallenge {
  tokenDigest   Bytes    @id @map("token_digest")
  userId        String   @map("user_id") @db.Uuid
  expiresAt     DateTime @map("expires_at") @db.Timestamptz(3)
  pendingSecret Bytes?   @map("pending_secret")
  user          User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("stead_login_challenges")
}

model Session {
  tokenDigest Bytes    @id @map("token_digest")
  userId      String   @map("user_id") @db.Uuid
  expiresAt   DateTime @map("expires_at") @db.Timestamptz(3)
  user        User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("stead_sessions")
}

// Public waitlist. Not user data: no userId. The runtime role may INSERT only; the owner reads it
// on the admin connection (see db/grant-runtime.sql).
model WaitlistEntry {
  id        String   @id @default(uuid()) @map("entry_id") @db.Uuid
  email     String   @unique @db.VarChar(254)
  locale    String   @db.VarChar(2)
  consentAt DateTime @default(now()) @map("consent_at") @db.Timestamptz(3)

  @@map("stead_waitlist")
}

model AuthLimit {
  phase         String   @db.VarChar(8)
  subjectDigest Bytes    @map("subject_digest")
  attempts      Int      @db.SmallInt
  windowUntil   DateTime @map("window_until") @db.Timestamptz(3)

  @@id([phase, subjectDigest])
  @@map("stead_auth_limits")
}

enum AccountType {
  CHECKING
  CARD
  BROKERAGE
  CRYPTO
  CASH
  DEBT
  PENSION

  @@map("stead_account_type")
}

enum CategoryKind {
  EXPENSE
  INCOME

  @@map("stead_category_kind")
}

enum TransferLeg {
  OUT
  IN

  @@map("stead_transfer_leg")
}

enum BudgetLimitKind {
  BASE
  OVERRIDE

  @@map("stead_budget_limit_kind")
}

enum RecurrenceFrequency {
  WEEKLY
  MONTHLY
  YEARLY

  @@map("stead_recurrence_frequency")
}

enum OccurrenceStatus {
  CONFIRMED
  MATCHED
  SKIPPED

  @@map("stead_occurrence_status")
}

// Every M1 table carries user_id. Child rows reference their parents through (user_id, id),
// so the database itself rejects a link between rows of two different users.

/// `type` always holds the base kind every rule keys off. A custom type only adds a user-chosen label;
/// the three-column foreign key keeps it in the same user and on the same base kind.
model Account {
  id         String              @id @default(uuid()) @map("account_id") @db.Uuid
  userId     String              @map("user_id") @db.Uuid
  name       String              @db.VarChar(80)
  type       AccountType
  customTypeId String?           @map("custom_type_id") @db.Uuid
  customType CustomAccountType?  @relation(fields: [userId, customTypeId, type], references: [userId, id, baseType], onDelete: Restrict, onUpdate: Restrict)
  archivedAt DateTime?           @map("archived_at") @db.Timestamptz(3)
  createdAt  DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  user       User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  movements  Movement[]
  templates  RecurringTemplate[]
  balanceChecks BalanceCheck[]
  investmentTransactions InvestmentTransaction[]
  mortgageProperties Property[]
  logo AccountLogo?

  @@unique([userId, id])
  @@unique([userId, name])
  @@map("stead_accounts")
}

/// A per-user account type: a name on top of a fixed built-in base kind. The base never changes
/// (the runtime role cannot UPDATE it); a type is deleted only while no account uses it.
model CustomAccountType {
  id         String      @id @default(uuid()) @map("type_id") @db.Uuid
  userId     String      @map("user_id") @db.Uuid
  name       String      @db.VarChar(80)
  baseType   AccountType @map("base_type")
  archivedAt DateTime?   @map("archived_at") @db.Timestamptz(3)
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  user       User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  accounts   Account[]

  @@unique([userId, id])
  @@unique([userId, name])
  @@unique([userId, id, baseType])
  @@map("stead_custom_account_types")
}

model AccountLogo {
  userId     String  @map("user_id") @db.Uuid
  accountId  String  @map("account_id") @db.Uuid
  image      Bytes   @map("image_enc")
  account    Account @relation(fields: [userId, accountId], references: [userId, id], onDelete: Cascade)

  @@id([userId, accountId])
  @@map("stead_account_logos")
}

model BalanceCheck {
  id           String   @id @default(uuid()) @map("check_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  accountId    String   @map("account_id") @db.Uuid
  /// End-of-day balance; movements on this date are already included.
  asOf         DateTime @map("as_of") @db.Date
  balanceCents Int      @map("balance_cents")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user         User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  account      Account  @relation(fields: [userId, accountId], references: [userId, id], onDelete: Restrict)

  @@unique([userId, accountId, asOf])
  @@unique([userId, id])
  @@map("stead_balance_checks")
}

model Category {
  id         String              @id @default(uuid()) @map("category_id") @db.Uuid
  userId     String              @map("user_id") @db.Uuid
  name       String              @db.VarChar(80)
  kind       CategoryKind
  archivedAt DateTime?           @map("archived_at") @db.Timestamptz(3)
  createdAt  DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  user       User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  movements  Movement[]
  rules      CategoryRule[]
  limits     BudgetLimit[]
  templates  RecurringTemplate[]

  @@unique([userId, id])
  @@unique([userId, name])
  @@map("stead_categories")
}

/// A transfer groups exactly one outgoing and one incoming movement (see Movement.transferLeg).
model Transfer {
  id        String     @id @default(uuid()) @map("transfer_id") @db.Uuid
  userId    String     @map("user_id") @db.Uuid
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User       @relation(fields: [userId], references: [id], onDelete: Restrict)
  legs      Movement[]

  @@unique([userId, id])
  @@map("stead_transfers")
}

model Movement {
  id          String               @id @default(uuid()) @map("movement_id") @db.Uuid
  userId      String               @map("user_id") @db.Uuid
  accountId   String               @map("account_id") @db.Uuid
  categoryId  String?              @map("category_id") @db.Uuid
  /// Calendar date as entered; no time zone applies to it.
  bookingDate DateTime             @map("booking_date") @db.Date
  /// AES-256-GCM envelope of the free-text description (see server/cash-flow/text-crypto.ts).
  description Bytes                @map("description_enc")
  /// Signed integer cents in EUR: negative leaves the account, positive enters it.
  amountCents Int                  @map("amount_cents")
  voidedAt    DateTime?            @map("voided_at") @db.Timestamptz(3)
  transferId  String?              @map("transfer_id") @db.Uuid
  transferLeg TransferLeg?         @map("transfer_leg")
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  user        User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  account     Account              @relation(fields: [userId, accountId], references: [userId, id], onDelete: Restrict)
  category    Category?            @relation(fields: [userId, categoryId], references: [userId, id], onDelete: Restrict)
  transfer    Transfer?            @relation(fields: [userId, transferId], references: [userId, id], onDelete: Restrict)
  occurrence  RecurringOccurrence?
  condoCharge CondoCharge?
  utilityBill UtilityBill?

  @@unique([userId, id])
  @@unique([transferId, transferLeg])
  @@index([userId, bookingDate])
  @@index([userId, accountId, bookingDate])
  @@index([userId, categoryId, bookingDate])
  @@map("stead_movements")
}

model CategoryRule {
  id         String   @id @default(uuid()) @map("rule_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  /// Normalized phrase (lower case, no accents, single spaces).
  phrase     String   @db.VarChar(60)
  categoryId String   @map("category_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user       User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  category   Category @relation(fields: [userId, categoryId], references: [userId, id], onDelete: Restrict)

  @@unique([userId, phrase])
  @@map("stead_category_rules")
}

/// BASE rows apply from `month` onward until a later BASE row; OVERRIDE rows apply to `month` only.
/// A BASE row with a null limit means "no budget from this month".
model BudgetLimit {
  id         String          @id @default(uuid()) @map("limit_id") @db.Uuid
  userId     String          @map("user_id") @db.Uuid
  categoryId String          @map("category_id") @db.Uuid
  /// First day of the month, Europe/Rome calendar.
  month      DateTime        @db.Date
  kind       BudgetLimitKind
  limitCents Int?            @map("limit_cents")
  user       User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  category   Category        @relation(fields: [userId, categoryId], references: [userId, id], onDelete: Restrict)

  @@unique([userId, categoryId, month, kind])
  @@map("stead_budget_limits")
}

model RecurringTemplate {
  id          String                @id @default(uuid()) @map("template_id") @db.Uuid
  userId      String                @map("user_id") @db.Uuid
  accountId   String                @map("account_id") @db.Uuid
  categoryId  String?               @map("category_id") @db.Uuid
  description Bytes                 @map("description_enc")
  /// Expected expense as a positive amount in cents; the booked movement is its negation.
  amountCents Int                   @map("amount_cents")
  frequency   RecurrenceFrequency
  /// First occurrence; monthly and yearly occurrences keep this day of the month.
  startDate   DateTime              @map("start_date") @db.Date
  endDate     DateTime?             @map("end_date") @db.Date
  archivedAt  DateTime?             @map("archived_at") @db.Timestamptz(3)
  deletedAt   DateTime?             @map("deleted_at") @db.Timestamptz(3)
  createdAt   DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  user        User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  account     Account               @relation(fields: [userId, accountId], references: [userId, id], onDelete: Restrict)
  category    Category?             @relation(fields: [userId, categoryId], references: [userId, id], onDelete: Restrict)
  occurrences RecurringOccurrence[]
  condoSchedule CondoSchedule?

  @@unique([userId, id])
  @@map("stead_recurring_templates")
}

/// One resolution per (template, due date). The unique key is what makes a confirmation happen once.
model RecurringOccurrence {
  id         String            @id @default(uuid()) @map("occurrence_id") @db.Uuid
  userId     String            @map("user_id") @db.Uuid
  templateId String            @map("template_id") @db.Uuid
  dueDate    DateTime          @map("due_date") @db.Date
  status     OccurrenceStatus
  movementId String?           @map("movement_id") @db.Uuid
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  user       User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  template   RecurringTemplate @relation(fields: [userId, templateId], references: [userId, id], onDelete: Restrict)
  movement   Movement?         @relation(fields: [userId, movementId], references: [userId, id], onDelete: Restrict)

  @@unique([templateId, dueDate])
  @@unique([userId, movementId])
  @@map("stead_recurring_occurrences")
}

enum InstrumentKind {
  STOCK
  ETF
  FUND
  IT_GOV_BOND
  BOND
  CRYPTO
  OTHER

  @@map("stead_instrument_kind")
}

enum InvestmentTransactionType {
  BUY
  SELL
  DIVIDEND
  COUPON

  @@map("stead_investment_transaction_type")
}

model Instrument {
  id String @id @default(uuid()) @map("instrument_id") @db.Uuid
  userId String @map("user_id") @db.Uuid
  name String @db.VarChar(120)
  symbol String? @db.VarChar(24)
  isin String? @db.VarChar(12)
  kind InstrumentKind
  marketSymbol String? @map("market_symbol")
  marketName String? @map("market_name")
  marketCurrency String? @map("market_currency")
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  transactions InvestmentTransaction[]
  quotes PriceQuote[]
  marketQuotes MarketPriceQuote[]

  @@unique([userId, id])
  @@unique([userId, name])
  @@map("stead_instruments")
}

model InvestmentTransaction {
  id String @id @default(uuid()) @map("transaction_id") @db.Uuid
  userId String @map("user_id") @db.Uuid
  accountId String @map("account_id") @db.Uuid
  instrumentId String @map("instrument_id") @db.Uuid
  type InvestmentTransactionType
  tradeDate DateTime @map("trade_date") @db.Date
  ordinal Int
  quantity Decimal? @db.Decimal(28, 10)
  amountCents BigInt @map("amount_cents")
  feesCents BigInt @map("fees_cents")
  taxWithheldCents BigInt @map("tax_withheld_cents")
  voidedAt DateTime? @map("voided_at") @db.Timestamptz(3)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  account Account @relation(fields: [userId, accountId], references: [userId, id], onDelete: Restrict)
  instrument Instrument @relation(fields: [userId, instrumentId], references: [userId, id], onDelete: Restrict)

  @@unique([userId, id])
  @@index([userId, instrumentId, tradeDate, ordinal])
  @@index([userId, accountId, tradeDate])
  @@map("stead_investment_transactions")
}

model PriceQuote {
  id String @id @default(uuid()) @map("quote_id") @db.Uuid
  userId String @map("user_id") @db.Uuid
  instrumentId String @map("instrument_id") @db.Uuid
  asOf DateTime @map("as_of") @db.Date
  unitPrice Decimal @map("unit_price") @db.Decimal(18, 8)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  instrument Instrument @relation(fields: [userId, instrumentId], references: [userId, id], onDelete: Restrict)

  @@unique([userId, id])
  @@unique([userId, instrumentId, asOf])
  @@map("stead_price_quotes")
}

model MarketPriceQuote {
  userId String @map("user_id") @db.Uuid
  instrumentId String @map("instrument_id") @db.Uuid
  asOf DateTime @map("as_of") @db.Date
  unitPrice Decimal @map("unit_price") @db.Decimal(18, 8)
  currency String
  fxRate Decimal? @map("fx_rate") @db.Decimal(28, 12)
  fxAsOf DateTime? @map("fx_as_of") @db.Date
  instrument Instrument @relation(fields: [userId, instrumentId], references: [userId, id], onDelete: Cascade)

  @@id([userId, instrumentId, asOf])
  @@map("stead_market_price_quotes")
}

model MarketCache {
  cacheKey String @id @map("cache_key")
  attemptedAt DateTime @map("attempted_at") @db.Timestamptz(3)
  payload Json?

  @@map("stead_market_cache")
}

model MarketRequest {
  id String @id @db.Uuid
  attemptedAt DateTime @map("attempted_at") @db.Timestamptz(3)
  throttled Boolean @default(false)

  @@index([attemptedAt])
  @@map("stead_market_requests")
}

enum PropertyKind {
  PRIMARY_RESIDENCE
  SECOND_HOME
  RENTAL
  LAND
  OTHER

  @@map("stead_property_kind")
}

enum CondoChargeKind {
  BALANCING
  EXTRAORDINARY

  @@map("stead_condo_charge_kind")
}

/// M4a. `ownershipBps` is the owner's share of the property (10000 = 100%); condominium millesimi live in CondoTable.
model Property {
  id String @id @default(uuid()) @map("property_id") @db.Uuid
  userId String @map("user_id") @db.Uuid
  name String @db.VarChar(80)
  kind PropertyKind
  ownershipBps Int @default(10000) @map("ownership_bps")
  /// Informational link to a DEBT account: the loan is already a liability in net worth.
  mortgageAccountId String? @map("mortgage_account_id") @db.Uuid
  soldOn DateTime? @map("sold_on") @db.Date
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)
  /// AES-256-GCM envelope of the street address (see server/cash-flow/text-crypto.ts). Not unique: two units can share it.
  address Bytes? @map("address_enc")
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  mortgageAccount Account? @relation(fields: [userId, mortgageAccountId], references: [userId, id], onDelete: Restrict)
  valuations PropertyValuation[]
  tables CondoTable[]
  schedules CondoSchedule[]
  charges CondoCharge[]
  bills UtilityBill[]

  @@unique([userId, id])
  @@unique([userId, name])
  @@unique([userId, mortgageAccountId])
  @@map("stead_properties")
}

/// Estimated value of 100% of the property on a date (the owner's own estimate).
model PropertyValuation {
  id String @id @default(uuid()) @map("valuation_id") @db.Uuid
  userId String @map("user_id") @db.Uuid
  propertyId String @map("property_id") @db.Uuid
  asOf DateTime @map("as_of") @db.Date
  valueCents BigInt @map("value_cents")
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  property Property @relation(fields: [userId, propertyId], references: [userId, id], onDelete: Restrict)

  @@unique([userId, id])
  @@unique([userId, propertyId, asOf])
  @@map("stead_property_valuations")
}

/// One millesimal table (for example General, Stairs, Lift): the unit's thousandths out of the building total.
model CondoTable {
  id String @id @default(uuid()) @map("table_id") @db.Uuid
  userId String @map("user_id") @db.Uuid
  propertyId String @map("property_id") @db.Uuid
  label String @db.VarChar(60)
  unitMillesimi Int @map("unit_millesimi")
  totalMillesimi Int @default(1000) @map("total_millesimi")
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  property Property @relation(fields: [userId, propertyId], references: [userId, id], onDelete: Restrict)

  @@unique([userId, id])
  @@unique([userId, propertyId, id])
  @@unique([userId, propertyId, label])
  @@map("stead_condo_tables")
}

/// Links an existing expense RecurringTemplate (condominium instalments) to a property.
model CondoSchedule {
  id String @id @default(uuid()) @map("schedule_id") @db.Uuid
  userId String @map("user_id") @db.Uuid
  propertyId String @map("property_id") @db.Uuid
  templateId String @map("template_id") @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  property Property @relation(fields: [userId, propertyId], references: [userId, id], onDelete: Restrict)
  template RecurringTemplate @relation(fields: [userId, templateId], references: [userId, id], onDelete: Restrict)

  @@unique([userId, id])
  @@unique([userId, templateId])
  @@map("stead_condo_schedules")
}

/// Historical one-off charges retained for backup and restore.
model CondoCharge {
  id String @id @default(uuid()) @map("charge_id") @db.Uuid
  userId String @map("user_id") @db.Uuid
  propertyId String @map("property_id") @db.Uuid
  kind CondoChargeKind
  /// AES-256-GCM envelope of the title (see server/cash-flow/text-crypto.ts).
  title Bytes @map("title_enc")
  dueDate DateTime @map("due_date") @db.Date
  /// What the owner pays; at most the movement limit because settling books it as one movement.
  amountCents Int @map("amount_cents")
  approvedOn DateTime? @map("approved_on") @db.Date
  /// Historical table ID. The referenced table may have been deleted since.
  tableId String? @map("table_id") @db.Uuid
  buildingTotalCents BigInt? @map("building_total_cents")
  voidedAt DateTime? @map("voided_at") @db.Timestamptz(3)
  movementId String? @map("movement_id") @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  property Property @relation(fields: [userId, propertyId], references: [userId, id], onDelete: Restrict)
  movement Movement? @relation(fields: [userId, movementId], references: [userId, id], onDelete: Restrict)

  @@unique([userId, id])
  @@unique([userId, movementId])
  @@index([userId, propertyId, dueDate])
  @@map("stead_condo_charges")
}

enum UtilityBillType {
  ELECTRICITY
  GAS
  INTERNET

  @@map("stead_utility_bill_type")
}

/// A utility bill of one property. Paid means linked to exactly one expense movement of the same amount.
model UtilityBill {
  id String @id @default(uuid()) @map("bill_id") @db.Uuid
  userId String @map("user_id") @db.Uuid
  propertyId String @map("property_id") @db.Uuid
  type UtilityBillType
  /// The provider that issued this bill; it can change from one bill to the next.
  provider String @db.VarChar(80)
  periodStart DateTime @map("period_start") @db.Date
  periodEnd DateTime @map("period_end") @db.Date
  dueDate DateTime @map("due_date") @db.Date
  /// What the owner pays; at most the movement limit because one movement settles it.
  totalCents Int @map("total_cents")
  /// Raw-material (energy) part of the total, for electricity and gas only.
  rawMaterialCents Int? @map("raw_material_cents")
  movementId String? @map("movement_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  property Property @relation(fields: [userId, propertyId], references: [userId, id], onDelete: Restrict)
  movement Movement? @relation(fields: [userId, movementId], references: [userId, id], onDelete: Restrict)

  @@unique([userId, id])
  @@unique([userId, movementId])
  @@index([userId, propertyId, dueDate])
  @@index([userId, dueDate])
  @@map("stead_utility_bills")
}
