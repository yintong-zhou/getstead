APP_ORIGIN=http://127.0.0.1:3000
DATABASE_URL=postgresql://stead_auth_app:YOUR_RUNTIME_PASSWORD@127.0.0.1:5432/stead
AUTH_ENCRYPTION_KEY=
# Optional: contact address shown in the waitlist privacy notice. Set it before the waitlist goes live.
PRIVACY_CONTACT_EMAIL=
# Cloudflare Turnstile for the waitlist. The site key is public; the secret stays server-side only.
# Without the secret the check is skipped in development and rejects every sign-up in production.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAGL7586vUtMshnHu
TURNSTILE_SECRET=
# Server-only. Required in Vercel to authenticate calls to the Python market-data function.
MARKET_DATA_BRIDGE_SECRET=
# Optional origin override for the Python function on a custom Vercel domain.
MARKET_DATA_BRIDGE_ORIGIN=
# Optional path to a local Python interpreter with requirements.txt installed.
MARKET_DATA_PYTHON=
